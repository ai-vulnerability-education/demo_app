# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# CORS Settings (Use * to allow all origins, or specify comma-separated origins)
# For production with Vercel: ALLOWED_ORIGINS=https://your-app.vercel.app
# For development: ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_ORIGINS=*

# Environment
ENVIRONMENT=production
